{
  "name": "local-terminal-actions",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.10.1",
  "publisher": "okasy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/okasy/vscode-ext-local-terminal-actions.git"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "l10n": "./l10n",
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "localTerminalActions",
          "title": "%views.container.title%",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "localTerminalActions": [
        {
          "id": "localTerminalActions.actions",
          "name": "%views.actions.name%",
          "when": "!localTerminalActions.editMode"
        },
        {
          "id": "localTerminalActions.settingEditActions",
          "name": "%views.settingEditActions.name%",
          "when": "localTerminalActions.editMode"
        },
        {
          "id": "localTerminalActions.settingGeneral",
          "name": "%views.settingGeneral.name%"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": ".vscode/actions.json",
        "url": "./schemas/actions.schema.json"
      }
    ],
    "viewsWelcome": [
      {
        "view": "localTerminalActions.actions",
        "contents": "%viewsWelcome.actions.noWorkspace%",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "localTerminalActions.actions",
        "contents": "%viewsWelcome.actions.noActions%",
        "when": "workspaceFolderCount > 0"
      },
      {
        "view": "localTerminalActions.settingGeneral",
        "contents": "%viewsWelcome.settingGeneral.noWorkspace%",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "localTerminalActions.settingEditActions",
        "contents": "%viewsWelcome.settingEditActions.noWorkspace%",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "localTerminalActions.settingEditActions",
        "contents": "%viewsWelcome.settingEditActions.noActions%",
        "when": "workspaceFolderCount > 0"
      }
    ],
    "commands": [
      {
        "command": "localTerminalActions.runAction",
        "title": "%commands.runAction.title%",
        "icon": {
          "light": "images/run-light.svg",
          "dark": "images/run-dark.svg"
        }
      },
      {
        "command": "localTerminalActions.runActionWithConfirm",
        "title": "%commands.runActionWithConfirm.title%",
        "icon": {
          "light": "images/run-confirm-light.svg",
          "dark": "images/run-confirm-dark.svg"
        }
      },
      {
        "command": "localTerminalActions.focusActionTerminal",
        "title": "%commands.focusActionTerminal.title%",
        "icon": "$(terminal)"
      },
      {
        "command": "localTerminalActions.closeActionTerminal",
        "title": "%commands.closeActionTerminal.title%",
        "icon": "$(close)"
      },
      {
        "command": "localTerminalActions.addAction",
        "title": "%commands.addAction.title%",
        "icon": "$(add)"
      },
      {
        "command": "localTerminalActions.enterEditMode",
        "title": "%commands.enterEditMode.title%",
        "icon": "$(edit)"
      },
      {
        "command": "localTerminalActions.exitEditMode",
        "title": "%commands.exitEditMode.title%",
        "icon": "$(check)"
      },
      {
        "command": "localTerminalActions.editAction",
        "title": "%commands.editAction.title%",
        "icon": "$(edit)"
      },
      {
        "command": "localTerminalActions.deleteAction",
        "title": "%commands.deleteAction.title%",
        "icon": "$(trash)"
      },
      {
        "command": "localTerminalActions.duplicateAction",
        "title": "%commands.duplicateAction.title%",
        "icon": "$(copy)"
      },
      {
        "command": "localTerminalActions.duplicateSection",
        "title": "%commands.duplicateSection.title%",
        "icon": "$(copy)"
      },
      {
        "command": "localTerminalActions.deleteSection",
        "title": "%commands.deleteSection.title%",
        "icon": "$(trash)"
      },
      {
        "command": "localTerminalActions.renameSection",
        "title": "%commands.renameSection.title%",
        "icon": "$(edit)"
      },
      {
        "command": "localTerminalActions.renameAction",
        "title": "%commands.renameAction.title%",
        "icon": "$(edit)"
      },
      {
        "command": "localTerminalActions.editActionDescription",
        "title": "%commands.editActionDescription.title%",
        "icon": "$(symbol-text)"
      },
      {
        "command": "localTerminalActions.openActionsFile",
        "title": "%commands.openActionsFile.title%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "localTerminalActions.editCommonOnNewTerminalCommand",
        "title": "%commands.editCommonOnNewTerminalCommand.title%",
        "icon": "$(edit)"
      },
      {
        "command": "localTerminalActions.editNewTerminalDelaySeconds",
        "title": "%commands.editNewTerminalDelaySeconds.title%",
        "icon": "$(edit)"
      },
      {
        "command": "localTerminalActions.refresh",
        "title": "%commands.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "localTerminalActions.cycleSubtextModeFromCommand",
        "title": "%commands.cycleSubtextModeFromCommand.title%",
        "icon": "$(terminal)"
      },
      {
        "command": "localTerminalActions.cycleSubtextModeFromDescription",
        "title": "%commands.cycleSubtextModeFromDescription.title%",
        "icon": "$(symbol-text)"
      },
      {
        "command": "localTerminalActions.cycleSubtextModeFromHidden",
        "title": "%commands.cycleSubtextModeFromHidden.title%",
        "icon": "$(eye-closed)"
      },
      {
        "command": "localTerminalActions.selectTreeSubtextMode",
        "title": "%commands.selectTreeSubtextMode.title%",
        "icon": "$(list-selection)"
      },
      {
        "command": "localTerminalActions.initActionsFile",
        "title": "%commands.initActionsFile.title%",
        "icon": "$(file-add)"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "localTerminalActions.treeSubtextMode": {
          "type": "string",
          "default": "command",
          "enum": [
            "command",
            "description",
            "hidden"
          ],
          "enumDescriptions": [
            "%configuration.treeSubtextMode.enum.command%",
            "%configuration.treeSubtextMode.enum.description%",
            "%configuration.treeSubtextMode.enum.hidden%"
          ],
          "markdownDescription": "%configuration.treeSubtextMode.markdownDescription%"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "localTerminalActions.enterEditMode",
          "when": "view == localTerminalActions.actions && !localTerminalActions.editMode",
          "group": "navigation"
        },
        {
          "command": "localTerminalActions.addAction",
          "when": "(view == localTerminalActions.actions && !localTerminalActions.editMode) || (view == localTerminalActions.settingEditActions && localTerminalActions.editMode)",
          "group": "navigation"
        },
        {
          "command": "localTerminalActions.exitEditMode",
          "when": "view == localTerminalActions.settingEditActions && localTerminalActions.editMode",
          "group": "navigation"
        },
        {
          "command": "localTerminalActions.refresh",
          "when": "view == localTerminalActions.actions || view == localTerminalActions.settingGeneral || view == localTerminalActions.settingEditActions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "localTerminalActions.runAction",
          "when": "view == localTerminalActions.actions && (viewItem == action || viewItem == action:executed)",
          "group": "inline"
        },
        {
          "command": "localTerminalActions.runActionWithConfirm",
          "when": "view == localTerminalActions.actions && (viewItem == action:confirm || viewItem == action:confirm:executed)",
          "group": "inline"
        },
        {
          "command": "localTerminalActions.focusActionTerminal",
          "when": "view == localTerminalActions.actions && (viewItem == action:executed || viewItem == action:confirm:executed)",
          "group": "inline"
        },
        {
          "command": "localTerminalActions.closeActionTerminal",
          "when": "view == localTerminalActions.actions && (viewItem == action:executed || viewItem == action:confirm:executed)",
          "group": "inline"
        },
        {
          "command": "localTerminalActions.editAction",
          "when": "view == localTerminalActions.settingEditActions && (viewItem == action:single || viewItem == action:top || viewItem == action:middle || viewItem == action:bottom)",
          "group": "inline"
        },
        {
          "command": "localTerminalActions.deleteAction",
          "when": "view == localTerminalActions.settingEditActions && (viewItem == action:single || viewItem == action:top || viewItem == action:middle || viewItem == action:bottom)",
          "group": "inline"
        },
        {
          "command": "localTerminalActions.duplicateAction",
          "when": "view == localTerminalActions.settingEditActions && (viewItem == action:single || viewItem == action:top || viewItem == action:middle || viewItem == action:bottom)",
          "group": "inline"
        },
        {
          "command": "localTerminalActions.duplicateSection",
          "when": "view == localTerminalActions.settingEditActions && (viewItem == section:single || viewItem == section:top || viewItem == section:middle || viewItem == section:bottom)",
          "group": "inline"
        },
        {
          "command": "localTerminalActions.renameSection",
          "when": "view == localTerminalActions.settingEditActions && (viewItem == section:single || viewItem == section:top || viewItem == section:middle || viewItem == section:bottom)",
          "group": "inline"
        },
        {
          "command": "localTerminalActions.deleteSection",
          "when": "view == localTerminalActions.settingEditActions && (viewItem == section:single || viewItem == section:top || viewItem == section:middle || viewItem == section:bottom)",
          "group": "inline"
        },
        {
          "command": "localTerminalActions.editCommonOnNewTerminalCommand",
          "when": "view == localTerminalActions.settingGeneral && viewItem == commonOnNewTerminalCommand",
          "group": "inline"
        },
        {
          "command": "localTerminalActions.editNewTerminalDelaySeconds",
          "when": "view == localTerminalActions.settingGeneral && viewItem == newTerminalDelaySeconds",
          "group": "inline"
        },
        {
          "command": "localTerminalActions.renameAction",
          "when": "view == localTerminalActions.actions && (viewItem == action || viewItem == action:executed || viewItem == action:confirm || viewItem == action:confirm:executed)",
          "group": "1_manage"
        },
        {
          "command": "localTerminalActions.editActionDescription",
          "when": "view == localTerminalActions.actions && (viewItem == action || viewItem == action:executed || viewItem == action:confirm || viewItem == action:confirm:executed)",
          "group": "1_manage"
        },
        {
          "command": "localTerminalActions.renameSection",
          "when": "view == localTerminalActions.actions && viewItem == section",
          "group": "1_manage"
        },
        {
          "command": "localTerminalActions.selectTreeSubtextMode",
          "when": "view == localTerminalActions.settingGeneral && viewItem == subtextModeSelector",
          "group": "1_manage"
        },
        {
          "command": "localTerminalActions.runAction",
          "when": "view == localTerminalActions.actions && (viewItem == action || viewItem == action:executed)",
          "group": "1_action"
        },
        {
          "command": "localTerminalActions.runActionWithConfirm",
          "when": "view == localTerminalActions.actions && (viewItem == action:confirm || viewItem == action:confirm:executed)",
          "group": "1_action"
        },
        {
          "command": "localTerminalActions.focusActionTerminal",
          "when": "view == localTerminalActions.actions && (viewItem == action:executed || viewItem == action:confirm:executed)",
          "group": "1_action"
        },
        {
          "command": "localTerminalActions.closeActionTerminal",
          "when": "view == localTerminalActions.actions && (viewItem == action:executed || viewItem == action:confirm:executed)",
          "group": "1_action"
        },
        {
          "command": "localTerminalActions.duplicateAction",
          "when": "view == localTerminalActions.settingEditActions && (viewItem == action:single || viewItem == action:top || viewItem == action:middle || viewItem == action:bottom)",
          "group": "1_manage"
        },
        {
          "command": "localTerminalActions.editAction",
          "when": "view == localTerminalActions.settingEditActions && (viewItem == action:single || viewItem == action:top || viewItem == action:middle || viewItem == action:bottom)",
          "group": "1_manage"
        },
        {
          "command": "localTerminalActions.renameAction",
          "when": "view == localTerminalActions.settingEditActions && (viewItem == action:single || viewItem == action:top || viewItem == action:middle || viewItem == action:bottom)",
          "group": "1_manage"
        },
        {
          "command": "localTerminalActions.editActionDescription",
          "when": "view == localTerminalActions.settingEditActions && (viewItem == action:single || viewItem == action:top || viewItem == action:middle || viewItem == action:bottom)",
          "group": "1_manage"
        },
        {
          "command": "localTerminalActions.deleteAction",
          "when": "view == localTerminalActions.settingEditActions && (viewItem == action:single || viewItem == action:top || viewItem == action:middle || viewItem == action:bottom)",
          "group": "1_manage"
        },
        {
          "command": "localTerminalActions.duplicateSection",
          "when": "view == localTerminalActions.settingEditActions && (viewItem == section:single || viewItem == section:top || viewItem == section:middle || viewItem == section:bottom)",
          "group": "1_manage"
        },
        {
          "command": "localTerminalActions.renameSection",
          "when": "view == localTerminalActions.settingEditActions && (viewItem == section:single || viewItem == section:top || viewItem == section:middle || viewItem == section:bottom)",
          "group": "1_manage"
        },
        {
          "command": "localTerminalActions.deleteSection",
          "when": "view == localTerminalActions.settingEditActions && (viewItem == section:single || viewItem == section:top || viewItem == section:middle || viewItem == section:bottom)",
          "group": "1_manage"
        },
        {
          "command": "localTerminalActions.editCommonOnNewTerminalCommand",
          "when": "view == localTerminalActions.settingGeneral && viewItem == commonOnNewTerminalCommand",
          "group": "1_manage"
        },
        {
          "command": "localTerminalActions.editNewTerminalDelaySeconds",
          "when": "view == localTerminalActions.settingGeneral && viewItem == newTerminalDelaySeconds",
          "group": "1_manage"
        },
        {
          "command": "localTerminalActions.initActionsFile",
          "when": "view == localTerminalActions.settingGeneral && viewItem == initActionsFile",
          "group": "1_file"
        },
        {
          "command": "localTerminalActions.openActionsFile",
          "when": "view == localTerminalActions.settingGeneral && viewItem == openActionsFile",
          "group": "1_file"
        }
      ]
    }
  },
  "scripts": {
    "setup:hooks": "git config core.hooksPath .githooks",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && node --test out/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.96.0",
    "typescript": "^5.0.0"
  }
}
